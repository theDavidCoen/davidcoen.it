# davidcoen.it — root .htaccess (static site + WordPress in /legacy/)
#
# Static files served when present. All other requests bootstrap WordPress
# via index.php (WordPress codex: own directory, site URL at root).

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Serve existing files and directories (static site, ebook/, .well-known/, …)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# WordPress front controller
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# Optional legacy page redirects (uncomment when ready)
# RewriteRule ^privacy-policy/?$ /privacy.html [R=301,L]
# RewriteRule ^payment-processor/?$ /accept-bitcoin.html [R=301,L]
