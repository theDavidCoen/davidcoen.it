# davidcoen.it root htaccess — static site + WordPress bootstrap

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Prefer /wp-admin/ over /legacy/wp-admin/
RewriteCond %{THE_REQUEST} \s/+legacy/wp-admin/ [NC]
RewriteRule ^legacy/wp-admin/?(.*)$ /wp-admin/$1 [R=301,L]

# WordPress admin/login — physical files under legacy/
RewriteRule ^wp-admin/?(.*)$ legacy/wp-admin/$1 [L]
RewriteRule ^wp-login\.php$ legacy/wp-login.php [L]

# /legacy/ alone is not a public page
RewriteCond %{THE_REQUEST} \s/legacy/?[\s?] [NC]
RewriteRule ^legacy/?$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
