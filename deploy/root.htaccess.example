# davidcoen.it root htaccess — static site + WordPress bootstrap

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Admin under /legacy/wp-admin/ bypasses root bootstrap — send to /wp-admin/
RewriteCond %{THE_REQUEST} \s/legacy/wp-admin/?(.*) [NC]
RewriteRule ^ /wp-admin/%1 [R=301,L]

# /legacy/ is not a public page (static home is /)
RewriteCond %{THE_REQUEST} \s/legacy/?[\s?] [NC]
RewriteRule ^legacy/?$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
